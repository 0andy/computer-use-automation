# Reference only — this file is NOT loaded at runtime. Export these in your shell.
# Set these in your shell (setx on Windows, export on macOS/Linux); there is no dotenv loading.
# Only genuine LLM Discovery needs the API key; Replay, Catalog, and the test suite run without it.
ANTHROPIC_API_KEY=
# Anthropic model identifier used by `cua discover`; discovery meta.json records the actual value.
CUA_MODEL=claude-sonnet-4-6
# Optional: override the MockBank base URL from config/apps/mockbank.yaml
# (the pytest fixture sets this automatically to its random-port server).
# MOCKBANK_BASE_URL=http://localhost:8000
